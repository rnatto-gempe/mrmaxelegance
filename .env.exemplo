# Cópia deste arquivo como `.env` e preencha. O `.env` está no .gitignore e
# nunca sobe: este repositório é público.
#
# Chave pessoal do PostHog, usada só das ferramentas em tools/ para criar e
# atualizar painéis. Ela lê e escreve a conta inteira — é o oposto da chave
# `phc_` do site, que só consegue enfileirar evento.
#
# PostHog → avatar → Personal API keys → Create personal API key
# Escopos: dashboard:write, insight:write, project:read
POSTHOG_API_KEY=phx_cole_aqui

# Região do projeto (o do MR MAX ELEGANCE é US)
POSTHOG_HOST=https://us.posthog.com
